{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: backend (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8001"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "internalConsole",
      "justMyCode": true
    }
  ]
}
